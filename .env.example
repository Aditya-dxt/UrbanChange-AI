# ==============================================================================
# UrbanChange AI — Environment Configuration Template
# Copy this file to .env (at repo root or inside backend/):
#   cp .env.example .env
# Never commit .env into source control.
# ==============================================================================

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development                       # development | staging | production
SECRET_KEY=change-me-in-production       # App secret key
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
REQUIRE_AUTH=false                       # Set to true to enforce API key / bearer auth
API_KEY=                                 # Secret token required when REQUIRE_AUTH=true

# ── Database (PostgreSQL + PostGIS) ───────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=urbanchange
POSTGRES_PORT=5432

# When running locally outside Docker:
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/urbanchange

# When running inside Docker via docker-compose (set automatically in docker-compose.yml):
# DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/urbanchange

# ── Storage Root ──────────────────────────────────────────────────────────────
# Shared folder where satellite imagery, change masks, and GIS geojson are stored.
# Outside Docker:
STORAGE_ROOT=/data/storage
# Windows local dev example:
# STORAGE_ROOT=C:/data/storage

# ── Adapter Modes ─────────────────────────────────────────────────────────────
# Set to 'mock' for standalone local dev (zero dependencies).
# Set to 'http' when connecting to a teammate's running service.
# For Intelligence only: can also be set to 'python' for direct module import.
SATELLITE_ADAPTER=mock                   # mock | http
ML_ADAPTER=mock                          # mock | http
GIS_ADAPTER=mock                         # mock | http
INTELLIGENCE_ADAPTER=mock                # mock | http | python

# ── Module HTTP Service URLs & Timeouts (used when adapter mode is 'http') ────
# Person 2 — Satellite Service
SATELLITE_BASE_URL=http://localhost:8001
SATELLITE_TIMEOUT_SECONDS=30

# Person 1 — ML Change Detection Service (SatQuery Siamese U-Net)
ML_ADAPTER=http                          # http | mock
ML_BASE_URL=http://localhost:8002
ML_TIMEOUT_SECONDS=60
ML_DEVICE=cpu                            # cpu | cuda
ML_WEIGHTS_PATH=ml/weights/best_siamese_model.pth
ML_THRESHOLD=0.5
ML_MIN_AREA_M2=50.0

# Person 3 — GIS Analysis Service
GIS_BASE_URL=http://localhost:8003
GIS_TIMEOUT_SECONDS=30

# Person 6 — Intelligence Service
INTELLIGENCE_BASE_URL=http://localhost:8004
INTELLIGENCE_TIMEOUT_SECONDS=60

# ── Intelligence Python Module Adapter (used only when INTELLIGENCE_ADAPTER=python) ──
# Format: package.module:callable
INTELLIGENCE_PYTHON_ENTRYPOINT=

# ── Pipeline & Rate Limiting ──────────────────────────────────────────────────
RUN_RATE_LIMIT_PER_MINUTE=10             # Rate limit for POST /api/investigations/{id}/run
TEMPORAL_MAX_OBSERVATIONS=0              # 0 = MVP two-date mode
CONTEXT_LAYER_IDS=                       # Comma-separated list of GIS layer IDs

# ── Satellite Copernicus CDSE Credentials (Optional, for Live Satellite) ─────
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# ── Intelligence LLM Settings (Optional, for Live Ollama) ─────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3:8b
