{
  "description": "Response to the assistant endpoint.",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "investigation_id": {
      "format": "uuid",
      "title": "Investigation Id",
      "type": "string"
    },
    "role": {
      "default": "assistant",
      "title": "Role",
      "type": "string"
    },
    "answer": {
      "title": "Answer",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "uncertainty_notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uncertainty Notes"
    },
    "status": {
      "default": "requires_human_verification",
      "title": "Status",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "investigation_id",
    "answer",
    "created_at"
  ],
  "title": "AssistantMessageOut",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
