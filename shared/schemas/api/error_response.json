{
  "description": "Uniform error shape for ALL error responses.",
  "properties": {
    "code": {
      "title": "Code",
      "type": "string"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "request_id": {
      "title": "Request Id",
      "type": "string"
    }
  },
  "required": [
    "code",
    "message",
    "request_id"
  ],
  "title": "ErrorResponse",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}